{
    admin off
    auto_https off
}

http://:{$PORT:10000} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        ?Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
    # App scripts and styles are requested with a ?v= version; a changed file gets a
    # new version, so a cached copy can never be stale. Fonts and logos rarely change.
    @app_versioned {
        path *.js *.css
        query v=*
        not path /api/* /wiki/* /caldock/* /decision-studio/*
    }
    header @app_versioned Cache-Control "public, max-age=31536000, immutable"
    @app_static path /fonts/* /assets/*
    header @app_static Cache-Control "public, max-age=604800"
    @private_or_uncached {
        not path /wiki/data/* /wiki/assets/* /caldock/assets/* /fonts/* /assets/*
        not {
            path *.js *.css
            query v=*
            not path /api/* /wiki/* /caldock/* /decision-studio/*
        }
    }
    header @private_or_uncached Cache-Control no-store
    # The original public Wiki keeps its existing framing restriction. Every
    # other same-origin route retains DENY/none, including the employee app/API.
    @not_wiki not path /wiki/*
    header @not_wiki {
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://login.dingtalk.com"
    }
    # Project files open in the WorkOS preview window (PDF, images): only the app itself
    # may frame them, and the file response runs no script. Everything else stays DENY.
    @project_file path /api/projects/files/*
    header @project_file {
        X-Frame-Options SAMEORIGIN
        Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; object-src 'self'; frame-ancestors 'self'"
    }
    # Enable only after the approved origin is switched. Keep the destination
    # literal: neither an incoming Host nor arbitrary environment text is a URL.
    @old_render_origin {
        host onelaser-workos.onrender.com
        expression `{env.APP_PUBLIC_URL} == 'https://craftos.app' || {env.APP_PUBLIC_URL} == 'https://craftos.app/'`
        not path /healthz /api/health
    }
    redir @old_render_origin https://craftos.app{uri} 307
    handle /healthz {
        rewrite * /health
        reverse_proxy 127.0.0.1:3001
    }
    @bot_oauth_metadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/api/integrations/grok-bot/mcp /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/api/integrations/grok-bot/oauth
    handle @bot_oauth_metadata {
        reverse_proxy 127.0.0.1:3001
    }
    handle_path /api/* {
        # Decision Studio is not public; see the page block below.
        @closed_studio_api path /caldock/studio /caldock/studio/*
        respond @closed_studio_api 404
        reverse_proxy 127.0.0.1:3001
    }
    handle /api {
        redir * /api/ 308
    }
    # Decision Studio is not public (owner decision, 2026-11-08).
    handle /decision-studio* {
        respond 404
    }
    # The storefront moved to its own domain; old links keep their path and query.
    handle /caldock {
        redir * https://wodemac.com/?{http.request.uri.query} 308
    }
    handle_path /caldock/* {
        redir * https://wodemac.com{uri} 308
    }
    handle /wiki {
        redir * /wiki/?{http.request.uri.query} 308
    }
    # These are pinned public documentation files, never employee/API content.
    @wiki_public_json path /wiki/data/*
    header @wiki_public_json Cache-Control "public, max-age=300"
    @wiki_public_assets path /wiki/assets/*
    header @wiki_public_assets Cache-Control "public, max-age=86400"
    handle_path /wiki/* {
        header {
            X-Frame-Options SAMEORIGIN
            # Seven original image hosts plus the verified Mubu redirect host.
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://wiki.1laser.com https://zohodesk.1laser.com https://www.1laser.com https://encrypted-tbn0.gstatic.com https://weacrylic.com https://images.openai.com https://api2.mubu.com https://document-image.mubu.com; connect-src 'self'; font-src 'self'; frame-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'"
        }
        root * /app/wiki
        file_server
    }
    handle {
        # Native Wiki articles render in the employee shell. Permit only their
        # audited image hosts and disable child frames; API/OAuth policy stays above.
        header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://wiki.1laser.com https://zohodesk.1laser.com https://www.1laser.com https://encrypted-tbn0.gstatic.com https://weacrylic.com https://images.openai.com https://api2.mubu.com https://document-image.mubu.com; connect-src 'self'; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://login.dingtalk.com"
        root * /app/public
        file_server
    }
}

# The wodeMac storefront. Only its pages and /api/caldock/* exist on this host, so
# no Work OS screen or API can be reached through the storefront domain.
http://www.wodemac.com:{$PORT:10000} {
    redir https://wodemac.com{uri} 308
}

http://wodemac.com:{$PORT:10000} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        ?Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Cache-Control no-store
    }
    @public_assets path /assets/*
    header @public_assets Cache-Control "public, max-age=86400"
    # Render's health check can arrive on this host; it must reach the API or deploys fail.
    handle /healthz {
        rewrite * /health
        reverse_proxy 127.0.0.1:3001
    }
    @caldock_api {
        path /api/caldock /api/caldock/*
        not path /api/caldock/studio /api/caldock/studio/*
    }
    handle @caldock_api {
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:3001
    }
    handle /api/* {
        respond 404
    }
    handle /decision-studio* {
        respond 404
    }
    handle {
        root * /app/caldock
        file_server
    }
    handle_errors {
        @missing expression `{http.error.status_code} == 404`
        rewrite @missing /404.html
        root * /app/caldock
        file_server {
            status 404
        }
    }
}
