# Test site with fictional data (tools/preview-local.ts), deployed by a separate Render service from the claude/preview branch.
# It has no database: everything lives in memory and resets on every deploy or restart. Never point it at production (erp.1laser.com / craftos.app) data.
FROM node:24-bookworm-slim AS frontend
WORKDIR /app
COPY tools/github-fetch-auth.mjs tools/fetch-frontend.mjs ./tools/
# The frontend commit to preview (usually a pull request head), in place of the production pin.
COPY deploy/preview-frontend-revision.txt ./deploy/frontend-revision.txt
RUN node tools/fetch-frontend.mjs /frontend && cp deploy/frontend-revision.txt /frontend-commit.txt

FROM node:24-bookworm-slim
ENV NODE_ENV=development HOST=0.0.0.0 PORT=10000 FRONTEND_DIST=/app/frontend PREVIEW_FRONTEND_COMMIT_FILE=/app/frontend-commit.txt
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npm cache clean --force
COPY tsconfig.json ./
COPY src ./src
COPY tools/preview-local.ts ./tools/preview-local.ts
COPY --from=frontend --chown=node:node /frontend ./frontend
COPY --from=frontend /frontend-commit.txt ./frontend-commit.txt
USER node
EXPOSE 10000
CMD ["node", "--import", "tsx", "tools/preview-local.ts"]
